{
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript --environment NODE_ENV:prod",
    "dev": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript -w --environment NODE_ENV:dev",
    "typecheck": "tsc --noEmit",
    "clean:out": "rm -rf dev *.user.js",
    "clean:deps": "rm -rf node_modules",
    "up:ver": "npm version patch && npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@rollup/plugin-replace": "catalog:",
    "@rollup/plugin-typescript": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-monkey": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:"
  }
}
